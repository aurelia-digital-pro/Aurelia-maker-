modules = ["nodejs-24", "python-base-3.12"]
run = ["bash", "scripts/start-canonical.sh"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "scripts/start-canonical.sh"]
build = ["bash", "scripts/build-production.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["espeak-ng", "ffmpeg-full", "freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]
